{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finance-agent.local/contracts/schema-embedding-snapshot-manifest-v2.schema.json",
  "title": "Schema Embedding Snapshot Artifact Manifest v2",
  "description": "Fail-closed file identity manifest generated from a local BGE-M3 or KURE-v1 snapshot. This schema is not a snapshot instance and contains no placeholder artifact hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "candidate",
    "files",
    "file_count",
    "total_size_bytes",
    "category_digests",
    "snapshot_file_manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "manifest_kind": {
      "const": "schema_embedding_snapshot_artifact"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "file_count": {
      "type": "integer",
      "minimum": 3
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "category_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weights",
        "tokenizer",
        "config",
        "other"
      ],
      "properties": {
        "weights": {
          "$ref": "#/$defs/requiredCategoryDigest"
        },
        "tokenizer": {
          "$ref": "#/$defs/requiredCategoryDigest"
        },
        "config": {
          "$ref": "#/$defs/requiredCategoryDigest"
        },
        "other": {
          "$ref": "#/$defs/categoryDigest"
        }
      }
    },
    "snapshot_file_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "model_id",
        "revision",
        "linkage_key"
      ],
      "properties": {
        "alias": {
          "enum": [
            "bge-m3",
            "kure-v1"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "linkage_key": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "sha256",
        "category"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "category": {
          "enum": [
            "weights",
            "tokenizer",
            "config",
            "other"
          ]
        }
      }
    },
    "categoryDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count",
        "total_size_bytes",
        "file_manifest_sha256"
      ],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "file_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requiredCategoryDigest": {
      "allOf": [
        {
          "$ref": "#/$defs/categoryDigest"
        },
        {
          "properties": {
            "file_count": {
              "minimum": 1
            }
          }
        }
      ]
    }
  },
  "x-artifact-contract": {
    "candidate_linkage": "sha256(utf8(model_id + LF + revision))",
    "candidate_source": "schema_embedding_models_v1.json",
    "supported_candidates": [
      {
        "alias": "bge-m3",
        "model_id": "BAAI/bge-m3",
        "revision": "5617a9f61b028005a4858fdac845db406aefb181"
      },
      {
        "alias": "kure-v1",
        "model_id": "nlpai-lab/KURE-v1",
        "revision": "d14c8a9423946e268a0c9952fecf3a7aabd73bd9"
      }
    ],
    "required_categories": [
      "weights",
      "tokenizer",
      "config"
    ],
    "approval_modes_requiring_a_verified_manifest": [
      "shadow",
      "production"
    ],
    "symlink_policy": "relative snapshot links may resolve only to regular files within an explicitly supplied trusted cache root",
    "tracked_snapshot_instance": false,
    "generation_command": "python -m finance_agent_core.evaluation.schema_embedding_artifacts create --model MODEL --snapshot-dir SNAPSHOT --trusted-cache-root CACHE --manifest OUTPUT"
  }
}

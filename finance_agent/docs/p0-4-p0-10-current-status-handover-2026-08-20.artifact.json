        "sql": "WITH stage_status(step, bucket) AS (VALUES (4, '완료'), (5, '범위·내부 완료'), (6, '범위·내부 완료'), (7, '범위·내부 완료'), (8, '완료'), (9, '미완료'), (10, '로컬 구현 완료')) SELECT COUNT(*) AS total_steps, SUM(CASE WHEN bucket = '완료' THEN 1 ELSE 0 END) AS fully_complete, SUM(CASE WHEN bucket = '범위·내부 완료' THEN 1 ELSE 0 END) AS scoped_complete, SUM(CASE WHEN bucket = '로컬 구현 완료' THEN 1 ELSE 0 END) AS local_complete, SUM(CASE WHEN bucket = '미완료' THEN 1 ELSE 0 END) AS incomplete FROM stage_status;"

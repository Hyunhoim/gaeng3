# Non-secret deployment identity. Copy to an ignored .env.release only after
# a clean release image has been pushed and its registry digest is known.
APP_ENV=evaluation
FINANCE_IMAGE_REFERENCE=registry.example/finance-agent@sha256:REPLACE_WITH_64_HEX
FINANCE_SOURCE_COMMIT=REPLACE_WITH_CLEAN_40_HEX_COMMIT
FINANCE_RUNTIME_PLATFORM=linux/amd64
FINANCE_DEPLOYMENT_BINDING_HOST_FILE=/absolute/path/deployment-binding.json
FINANCE_DEPLOYMENT_BINDING_SHA256=REPLACE_WITH_64_HEX
FINANCE_RELEASE_MANIFEST_HOST_FILE=/absolute/path/agent-release-manifest.json
FINANCE_RELEASE_MANIFEST_SIGSTORE_BUNDLE_HOST_FILE=/absolute/path/agent-release-manifest.sigstore.json
FINANCE_DEPLOYMENT_BINDING_SIGSTORE_BUNDLE_HOST_FILE=/absolute/path/deployment-binding.sigstore.json
FINANCE_DATA_VOLUME_NAME=finance-data-REPLACE_WITH_RELEASE_ID-REPLACE_WITH_MANIFEST_SHA12
# SHA-256 printed in /data/relation-retrieval-artifact.sha256 after the approved
# data-init run. Copy the 64 hex characters here; release runtime does not trust
# the co-located sidecar file.
FINANCE_RELATION_RETRIEVAL_ARTIFACT_SHA256=REPLACE_WITH_64_HEX
# Pre-create as UID/GID 10001, mode 0700. Audit files inside are mode 0600.
FINANCE_AUDIT_HOST_DIR=/absolute/path/owner-only-audit-directory

# Official evaluator uses unauthenticated HTTP on the public endpoint. Restrict
# inbound port 80 to the evaluator source IP range at the host firewall.
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=80
LOG_LEVEL=info
WEB_CONCURRENCY=1
OFFICIAL_ANSWER_TIMEOUT_SECONDS=270
OFFICIAL_ANSWER_MAX_INFLIGHT=2
FINANCE_BACKEND_FUND_EXECUTION_POLICY=public_fund_v1_approved
FINANCE_AUDIT_QUEUE_CAPACITY=2048
FINANCE_AUDIT_SHUTDOWN_TIMEOUT_SECONDS=5
FINANCE_AUDIT_FSYNC_EACH_EVENT=true

# Final evaluation profile: HCLX Intent + final generation around deterministic execution.
FINANCE_BACKEND_ANSWER_PROVIDER=hyperclova
FINANCE_BACKEND_HCX_QUERY_PLAN_ENABLED=false
FINANCE_BACKEND_HCX_INTENT_ANALYSIS_ENABLED=true
FINANCE_BACKEND_HCX_SEMANTIC_RESOLVER_ENABLED=true
FINANCE_ADAPTIVE_SEMANTIC_ENABLED=true
FINANCE_SCHEMA_DENSE_INDEX_HOST_FILE=/absolute/path/schema-dense-index.json
FINANCE_SCHEMA_DENSE_INDEX_SHA256=2807195ef8c233ab3218ff742a4f53e11728aa63b56bbeb6dce62bb178f6ae57
FINANCE_SCHEMA_DENSE_CALIBRATION_REPORT_SHA256=8c41295bf0746bf395b0898863b406f18f6cbd8a42a4cc379069e88ab85c3a09
FINANCE_SCHEMA_DENSE_MIN_SCORE=0.340015
FINANCE_SCHEMA_DENSE_HCLX_CANDIDATE_MIN_SCORE=0.3
FINANCE_SCHEMA_DENSE_MINIMUM_MARGIN=0.034684
FINANCE_SCHEMA_DENSE_TOP_K=10
FINANCE_KURE_CACHE_HOST_DIR=/absolute/path/kure-cache
FINANCE_KURE_SNAPSHOT_MANIFEST_HOST_FILE=/absolute/path/kure-snapshot-manifest.json
FINANCE_KURE_CPU_THREADS=2
FINANCE_KURE_BATCH_SIZE=16
FINANCE_AGENT_LLM_MODE=evaluation
LLM_PROVIDER=hyperclova
HCX_MODEL=HCX-007
HCX_TIMEOUT_SECONDS=45
CLOVASTUDIO_API_KEY_HOST_FILE=/absolute/path/clovastudio-api-key
CLOVASTUDIO_API_KEY_FILE=/run/secrets/clovastudio_api_key

# Official-domain external evidence. The final evaluation profile should use a
# signed approved_corpus_cache_only artifact and leave NAVER credentials unset.
FINANCE_EXTERNAL_KNOWLEDGE_ENABLED=true
FINANCE_EXTERNAL_KNOWLEDGE_ARTIFACT_HOST_FILE=/absolute/path/external-knowledge-artifact.json
FINANCE_EXTERNAL_KNOWLEDGE_ARTIFACT_FILE=/run/finance-release/external-knowledge-artifact.json
FINANCE_EXTERNAL_KNOWLEDGE_ARTIFACT_SHA256=REPLACE_WITH_64_HEX
FINANCE_EXTERNAL_TEMPORAL_RELATION_HOST_FILE=/absolute/path/external-temporal-relations.json
FINANCE_EXTERNAL_TEMPORAL_RELATION_FILE=/run/finance-release/external-temporal-relations.json
FINANCE_EXTERNAL_TEMPORAL_RELATION_SHA256=REPLACE_WITH_64_HEX
# Leave the eight values below unset for verified_live_official releases. Set
# all eight only when the signed external artifact was created from an
# independently reviewed approved corpus and has retrieval_mode
# approved_corpus_cache_only or approved_corpus_cache_first. The application
# verifies the index, activation receipt and exact corpus snapshots against the
# signed artifact before serving a request.
# FINANCE_EXTERNAL_DOCUMENT_DENSE_ARTIFACT_HOST_FILE=/absolute/path/document-dense-approved.json
# FINANCE_EXTERNAL_DOCUMENT_DENSE_ARTIFACT_FILE=/models/document-dense-approved.json
# FINANCE_EXTERNAL_DOCUMENT_CACHE_ACTIVATION_HOST_FILE=/absolute/path/document-cache-activation.json
# FINANCE_EXTERNAL_DOCUMENT_CACHE_ACTIVATION_FILE=/run/finance-release/document-cache-activation.json
# FINANCE_EXTERNAL_DOCUMENT_CORPUS_MANIFEST_HOST_FILE=/absolute/path/approved-corpus-manifest.json
# FINANCE_EXTERNAL_DOCUMENT_CORPUS_MANIFEST_FILE=/run/finance-release/approved-corpus-manifest.json
# FINANCE_EXTERNAL_DOCUMENT_CORPUS_HOST_DIR=/absolute/path/approved-corpus
# FINANCE_EXTERNAL_DOCUMENT_CORPUS_ROOT=/run/finance-corpus
# Leave NAVER values unset for approved_corpus_cache_only: the Live Search
# overlay and its secrets will not be mounted. Configure all four only for a
# signed live/cache-first release outside the evaluation path.
# NAVER_API_HUB_CLIENT_ID_HOST_FILE=/absolute/path/naver-api-hub-client-id
# NAVER_API_HUB_CLIENT_SECRET_HOST_FILE=/absolute/path/naver-api-hub-client-secret
# NAVER_API_HUB_CLIENT_ID_FILE=/run/secrets/naver_api_hub_client_id
# NAVER_API_HUB_CLIENT_SECRET_FILE=/run/secrets/naver_api_hub_client_secret

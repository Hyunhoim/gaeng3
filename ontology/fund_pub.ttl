fund:Dataset
    a ga:Dataset ;
    ga:registryName "fund" ;
    ga:sourceId "PRFD01N001" ;
    ga:sourceLabel "공모펀드 마스터"@ko ;
    ga:logicalGrain "itm_no로 식별되는 펀드 클래스 한 상품"@ko ;
    ga:snapshotDate "2026-07-11"^^xsd:date ;
    ga:rowCount 95619 ;
    ga:logicalRowCount 11138 ;
    ga:quarantinedRows 1 ;
    ga:executionEnabled false ;
    ga:primaryKey "itm_no" ;
    ga:rawPrimaryKey "itm_no" ;
    ga:rawPrimaryKey "prfd_attr_cd" ;
    ga:rawFilePattern "PRFD01N001*_datarows*.xlsx" ;
    ga:schemaFilePattern "PRFD01N001*_schema*.xlsx" ;
    ga:staticAsOfColumn "__file_snapshot__" ;
    ga:dynamicAsOfColumn "__file_snapshot__" ;
    ga:notes "정상 상품 11,138개 중 공모 11,115개, 사모 15개, 공사모 구분 결측 8개다. 실행 파이프라인이 구현될 때까지 HCX QueryPlan에서는 닫아 둔다."@ko .


<https://gaeng3.ai/ontology/etf_gl>
    a owl:Ontology ;
    owl:imports <https://gaeng3.ai/ontology/common> ;
    rdfs:label "해외 ETF·ETN Ontology"@ko ;
    ga:registryVersion "1.3" .

etfgl:GlobalETPProduct
    a owl:Class ;
    rdfs:subClassOf ga:FinancialProduct ;
    rdfs:label "해외 ETF·ETN 상품"@ko .

etfgl:Family
    a ga:ProductFamily ;
    rdfs:label "해외 ETF·ETN"@ko ;
    ga:registryName "overseas_etp" ;
    ga:describedByDataset etfgl:Dataset ;
    ga:hasCanonicalField etfgl:field_product_id ;
    ga:hasCanonicalField etfgl:field_product_family ;
    ga:hasCanonicalField etfgl:field_product_type ;
    ga:hasCanonicalField etfgl:field_product_name ;

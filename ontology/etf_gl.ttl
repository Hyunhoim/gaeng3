    ga:registryName "overseas_etp" ;
    ga:sourceId "PREF02N001" ;
    ga:sourceLabel "해외 ETF 마스터"@ko ;
    ga:logicalGrain "거래소 코드와 종목 번호로 식별되는 해외 ETP 한 종목"@ko ;
    ga:snapshotDate "2026-07-11"^^xsd:date ;
    ga:rowCount 5646 ;
    ga:quarantinedRows 10 ;
    ga:executionEnabled true ;
    ga:primaryKey "pd_exg_mkt_cd" ;
    ga:primaryKey "pd_itm_no" ;
    ga:rawFilePattern "PREF02N001*_datarows*.xlsx" ;
    ga:schemaFilePattern "PREF02N001*_schema*.xlsx" ;
    ga:staticAsOfColumn "cu_upt_dt" ;
    ga:dynamicAsOfColumn "du_upt_dt" ;
    ga:notes ""@ko .


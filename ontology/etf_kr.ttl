    ga:registryName "domestic_etp" ;
    ga:sourceId "PREF01N001" ;
    ga:sourceLabel "국내 ETF·ETN 마스터"@ko ;
    ga:logicalGrain "pd_itm_no로 식별되는 국내 상장 ETP 한 종목"@ko ;
    ga:snapshotDate "2026-07-11"^^xsd:date ;
    ga:rowCount 1734 ;
    ga:quarantinedRows 1 ;
    ga:executionEnabled true ;
    ga:primaryKey "pd_itm_no" ;
    ga:rawFilePattern "PREF01N001*_datarows*.xlsx" ;
    ga:schemaFilePattern "PREF01N001*_schema*.xlsx" ;
    ga:staticAsOfColumn "wu_upt_dt" ;
    ga:dynamicAsOfColumn "du_upt_dt" ;
    ga:notes ""@ko .


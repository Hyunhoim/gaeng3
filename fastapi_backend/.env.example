# Host-side Docker settings
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=18001
FINANCE_ARTIFACTS_DIR=./finance_agent/artifacts/normalized

# Backend process settings
APP_ENV=development
LOG_LEVEL=info
WEB_CONCURRENCY=1

# Docker 없이 실행할 때 사용할 SQLite 경로 예시입니다. Compose는 아래 값을
# 컨테이너의 /data 경로로 자동 설정하므로 Docker 실행 시에는 수정하지 않습니다.
# FINANCE_DB_OVERSEAS_ETP=../finance_agent/artifacts/normalized/overseas_etp.sqlite3
# FINANCE_DB_DOMESTIC_ETP=../finance_agent/artifacts/normalized/domestic_etp.sqlite3
# FINANCE_DB_BOND=../finance_agent/artifacts/normalized/bond.sqlite3
# FINANCE_DB_FUND=../finance_agent/artifacts/normalized/fund.sqlite3

# HyperCLOVA X integration is intentionally disabled until credentials and the
# official endpoint contract are confirmed. Never commit real credentials.
# FINANCE_AGENT_LLM_MODE=evaluation
# LLM_PROVIDER=hyperclova
# HCX_MODEL=HCX-...
# HCX_TIMEOUT_SECONDS=60

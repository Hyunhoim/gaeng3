# Host-side Docker settings
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=18001

# Official raw XLSX directory. Compose mounts this directory read-only and
# prepares four normalized SQLite databases in its private named volume.
FINANCE_RAW_DATA_DIR=../../2. Data/1. Raw/1.금융상품

# compose.sh가 실행 사용자의 UID/GID를 자동 전달하므로 여기에 고정하지 않습니다.
# Docker Compose를 직접 호출해야 할 때만 같은 터미널에서 다음 값을 설정합니다.
# BACKEND_HOST_UID=<id -u 결과>
# BACKEND_HOST_GID=<id -g 결과>

# Backend process settings
# 기본 Compose는 연구실 서버용 development 경로입니다. evaluation/production은
# clean commit에서 release artifacts를 만든 뒤 compose-release.sh로만 시작합니다.
APP_ENV=development
LOG_LEVEL=info
WEB_CONCURRENCY=1
OFFICIAL_ANSWER_TIMEOUT_SECONDS=270
OFFICIAL_ANSWER_MAX_INFLIGHT=2

# 공모펀드 v1 데이터 계약을 팀이 승인한 실행에서만 아래 값을 사용합니다.
# 기본값 locked에서는 공모펀드 질문이 실행 전에 unsupported로 종료됩니다.
# FINANCE_BACKEND_FUND_EXECUTION_POLICY=public_fund_v1_approved

# 기본 Backend는 모델 없이 결정론적으로 답변합니다. 개발용 로컬 Qwen 연결은
# 이 파일을 바꾸지 말고 docker-compose.local-llm.yml override를 사용합니다.
# FINANCE_BACKEND_ANSWER_PROVIDER=deterministic

# Docker 없이 실행할 때 사용할 SQLite 경로 예시입니다. Compose는 정규화 DB를
# 전용 volume에 자동 생성하고 /data로 연결하므로 Docker 실행 시에는 수정하지 않습니다.
# FINANCE_DB_OVERSEAS_ETP=../finance_agent/artifacts/normalized/overseas_etp.sqlite3
# FINANCE_DB_DOMESTIC_ETP=../finance_agent/artifacts/normalized/domestic_etp.sqlite3
# FINANCE_DB_BOND=../finance_agent/artifacts/normalized/bond.sqlite3
# FINANCE_DB_FUND=../finance_agent/artifacts/normalized/fund.sqlite3

# HyperCLOVA X cannot be enabled by this development Compose profile.
# evaluation/production uses only compose-release.sh and a read-only credential
# file configured through fastapi_backend/.env.release. See .env.release.example.
# Never put CLOVASTUDIO_API_KEY or any credential value in an environment file.

# Evaluation/production release identity (development에서는 설정하지 않음)
# 실제 값은 clean commit → release image build/push → digest 확정 뒤 작성합니다.
# FINANCE_IMAGE_REFERENCE=registry.example/finance-agent@sha256:<64-hex>
# FINANCE_SOURCE_COMMIT=<clean-commit-40-hex>
# FINANCE_DEPLOYMENT_BINDING_HOST_FILE=/absolute/path/deployment-binding.json
# FINANCE_DEPLOYMENT_BINDING_SHA256=<64-hex>
# FINANCE_DATA_VOLUME_NAME=finance-data-<release-id>

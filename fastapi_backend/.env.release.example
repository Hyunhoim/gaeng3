# Non-secret deployment identity. Copy to an ignored .env.release only after
# a clean release image has been pushed and its registry digest is known.
APP_ENV=evaluation
FINANCE_IMAGE_REFERENCE=registry.example/finance-agent@sha256:REPLACE_WITH_64_HEX
FINANCE_SOURCE_COMMIT=REPLACE_WITH_CLEAN_40_HEX_COMMIT
FINANCE_RUNTIME_PLATFORM=linux/amd64
FINANCE_DEPLOYMENT_BINDING_HOST_FILE=/absolute/path/deployment-binding.json
FINANCE_DEPLOYMENT_BINDING_SHA256=REPLACE_WITH_64_HEX
FINANCE_RELEASE_MANIFEST_HOST_FILE=/absolute/path/agent-release-manifest.json
FINANCE_RELEASE_MANIFEST_SIGSTORE_BUNDLE_HOST_FILE=/absolute/path/agent-release-manifest.sigstore.json
FINANCE_DEPLOYMENT_BINDING_SIGSTORE_BUNDLE_HOST_FILE=/absolute/path/deployment-binding.sigstore.json
FINANCE_DATA_VOLUME_NAME=finance-data-REPLACE_WITH_RELEASE_ID-REPLACE_WITH_MANIFEST_SHA12
# Pre-create as UID/GID 10001, mode 0700. Audit files inside are mode 0600.
FINANCE_AUDIT_HOST_DIR=/absolute/path/owner-only-audit-directory

BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=18001
LOG_LEVEL=info
WEB_CONCURRENCY=1
OFFICIAL_ANSWER_TIMEOUT_SECONDS=55
OFFICIAL_ANSWER_MAX_INFLIGHT=2
FINANCE_BACKEND_FUND_EXECUTION_POLICY=locked
FINANCE_AUDIT_QUEUE_CAPACITY=2048
FINANCE_AUDIT_SHUTDOWN_TIMEOUT_SECONDS=5
FINANCE_AUDIT_FSYNC_EACH_EVENT=true

# Deterministic release is the default and must not provide an HCLX key.
FINANCE_BACKEND_ANSWER_PROVIDER=deterministic
FINANCE_BACKEND_HCX_QUERY_PLAN_ENABLED=false
FINANCE_AGENT_LLM_MODE=disabled
LLM_PROVIDER=disabled
# For a HyperCLOVA release, change the four values above to the manifest profile,
# set HCX_MODEL=HCX-007, and point this to a read-only host secret file.
# CLOVASTUDIO_API_KEY_HOST_FILE=/absolute/path/clovastudio-api-key
# CLOVASTUDIO_API_KEY_FILE=/run/secrets/clovastudio_api_key
# HCX_MODEL=HCX-007
# HCX_TIMEOUT_SECONDS=45

# Docker Compose builds from the repository root, so this Dockerfile-specific
# ignore file is the active equivalent of fastapi_backend/.dockerignore.
.git
.github
.env
.env.*
!.env.example
Data/
finance_agent/artifacts/
finance_agent/docs/
finance_agent/evaluation/
finance_agent/notebooks/
finance_agent/reports/
finance_agent/scripts/
fastapi_backend/tests/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.egg-info/
**/*.log

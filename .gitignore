# Generated local evaluation observations and rendered reports. Keep the
# reusable suites and evaluator code in Git, but never commit raw responses.
src/finance_agent/evaluation/baselines/document-dense-public-calibration-kure-*.json
src/finance_agent/evaluation/baselines/kure-schema-dense-*.json
src/finance_agent/evaluation/baselines/schema-dense-final-runtime-probe-*.json
